// ============================================================
// 一人食·川菜推荐官 — Prisma Schema
// 数据库：PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 用户模型（NextAuth 兼容）
model User {
  id            String    @id @default(cuid())
  name          String?   // 昵称
  email         String?   @unique // 邮箱
  emailVerified DateTime? // 邮箱验证时间
  image         String?   // 头像 URL
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  spicyLevel    Int       @default(3) // 辣度偏好 1-5
  dislikes      String[]  // 忌口清单
  provider      String    @default("deepseek") // AI 服务商
  apiKey        String?   // 加密存储的 API Key
  accounts      Account[]
  sessions      Session[]
  recommendations Recommendation[]
  blacklistItems  BlacklistItem[]
  groups        Group[]   // 创建的聚餐房间
}

/// NextAuth 账号绑定
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// NextAuth 会话
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// NextAuth 验证令牌
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// 每日推荐记录
model Recommendation {
  id        String   @id @default(cuid())
  date      DateTime // 推荐日期
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cook      Json     // {dish, reason, quickTip, ingredients}
  takeout   Json     // {dish, reason, tip}
  eatOut    Json     // {type, dish, tip}
  createdAt DateTime @default(now())

  @@unique([date, userId]) // 每个用户每天只能有一条推荐
  @@index([userId])
  @@index([date])
}

/// 黑名单菜品（用于防重复推荐，7天TTL自动清理）
model BlacklistItem {
  id        String   @id @default(cuid())
  dishName  String   // 菜品名称
  userId    String?  // 关联用户（可选，全局黑名单可为空）
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([dishName])
  @@index([createdAt])
  @@index([userId, createdAt])
}

/// 推荐反馈评分
model Feedback {
  id             String   @id @default(cuid())
  userId         String?  // 用户 ID（可选，匿名也可评分）
  recommendationId String? // 关联推荐 ID（可选）
  rating         Int      // 评分：1=👍, -1=👎
  cookDish       String   // 做饭菜品名
  takeoutDish    String   // 外卖菜品名
  eatOutDish     String   // 出去吃菜品名
  section        String?  // 评分的具体板块：cook/takeout/eatOut
  spicyLevel     Int      // 当时的辣度设置
  dislikes       String[] // 当时的忌口设置
  comment        String?  // 可选备注
  createdAt      DateTime @default(now())

  @@index([rating])
  @@index([cookDish])
  @@index([takeoutDish])
  @@index([createdAt])
  @@index([userId])
}

/// 聚餐房间
model Group {
  id          String        @id @default(cuid())
  code        String        @unique // 短链接代码（6位）
  name        String        // 房间名称
  creatorId   String        // 创建者 ID
  creator     User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status      String        @default("waiting") // waiting/recommending/completed
  city        String?       // 城市
  location    Json?         // {lat, lng} 位置
  aiResult    Json?         // AI 推荐结果
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]

  @@index([code])
  @@index([creatorId])
  @@index([status])
}

/// 聚餐成员
model GroupMember {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String?  // 可选，匿名用户可加入
  nickname    String   // 昵称
  spicyLevel  Int      @default(3) // 辣度偏好 1-5
  dislikes    String[] // 忌口清单
  preferences String?  // 其他偏好
  isCreator   Boolean  @default(false) // 是否是创建者
  joinedAt    DateTime @default(now())

  @@unique([groupId, nickname])
  @@index([groupId])
}
