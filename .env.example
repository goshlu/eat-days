# ============================================================
# 一人食·川菜推荐官 — 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# ============================================================

# PostgreSQL 数据库连接地址
DATABASE_URL=postgresql://user:password@localhost:5432/sichuan_food_agent

# DeepSeek API Key（推荐，性价比高）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key（可选）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenWeatherMap 天气 API（可选，免费计划可用）
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Upstash Redis（可选，用于缓存推荐结果）
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NextAuth.js（可选，用于用户登录）
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-key-here

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sentry（可选，用于错误追踪）
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxx
